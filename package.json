{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=low",
    "audit:fix": "npm audit fix",
    "check": "npm run lint && npm run format:check && npm run audit",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.5",
    "@giscus/react": "^3.1.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/og": "0.6.8",
    "@vercel/speed-insights": "1.3.1",
    "next": "^16.3.6",
    "next-mdx-remote": "6.0.0",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "swr": "2.5.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  }
}
